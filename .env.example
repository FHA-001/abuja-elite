# Copy this file to artifacts/abuja-elite/.env.local.
# Browser values only. Never put a service-role/secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional until public forms are deployed. Without this, Instagram contact is shown.
VITE_TURNSTILE_SITE_KEY=
# Set to your actual HTTPS production origin for canonical links and sitemap.
VITE_SITE_URL=
